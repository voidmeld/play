--!strict

local Bdd = require("../../.lute/dependencies/verify/src/bdd")
local Protocol = require("./protocol")
local Roblox = require("../../.lute/dependencies/verify/src/roblox")
local Scene = require("./scene")
local State = require("./state")
local Verify = require("../../.lute/dependencies/verify/src/core")

return function(suite: Verify.Harness)
	local test = Bdd.create(suite)
	local describe, it, expect = test.describe, test.it, test.expect

	describe("persistent world assembly", function()
		it("releases completed combat timers during a continuing session", function()
			local scene = Scene.new()
			local client = scene.connect(11)
			local equip: Protocol.EquipRequest = { kind = "equip", itemId = "training_sword" }
			client.request(equip)
			local baseline = scene.ownedTaskCount()
			for _ = 1, 8 do
				for _ = 1, 3 do
					client.request({ kind = "attack" })
					expect(assert(client.latest()).ok):toBe(true)
					scene.clock.advance(0.25)
					scene.clock.advance(0.3)
				end
				scene.clock.advance(3)
				expect((scene.mount.world.enemy())):toBe(30)
				expect(scene.ownedTaskCount()):toBe(baseline)
			end
			expect(assert(scene.mount.world.view(11)).xp):toBe(800)
			expect(scene.engine.scheduler.failures):toEqual({})
			client.request({ kind = "attack" })
			expect(assert(client.latest()).ok):toBe(true)
			expect(scene.mount.shutdown()):toBe(true)
			expect(scene.ownedTaskCount()):toBe(0)
			scene.clock.advance(4)
			expect((scene.mount.world.enemy())):toBe(30)
			expect(scene.engine.scheduler.failures):toEqual({})
			client.dispose()
			scene.dispose()
		end)
		it("rechecks recovery after a yielding contact admission observation", function()
			local scene = Scene.new()
			local client = scene.connect(11)
			local equip: Protocol.EquipRequest = { kind = "equip", itemId = "training_sword" }
			client.request(equip)
			local held: thread? = nil
			scene.control.onObserve = function(_userId: number): ()
				scene.control.onObserve = nil
				scene.engine.scheduler.block(function(pending)
					held = pending
				end)
			end
			scene.engine.scheduler.spawn(function()
				client.request({ kind = "attack" })
			end)
			expect(held == nil):toBe(false)
			client.request({ kind = "attack" })
			expect(assert(client.latest()).ok):toBe(true)
			scene.engine.scheduler.resume(assert(held))
			scene.clock.advance(0)
			expect(assert(client.latest()).ok):toBe(false)
			expect(assert(client.latest()).reason):toBe("recovering")
			scene.clock.advance(0.25)
			expect((scene.mount.world.enemy())):toBe(20)
			client.request({ kind = "attack" })
			expect(assert(client.latest()).reason):toBe("recovering")
			scene.clock.advance(0.3)
			client.request({ kind = "attack" })
			expect(assert(client.latest()).ok):toBe(true)
			scene.clock.advance(0.25)
			expect((scene.mount.world.enemy())):toBe(10)
			expect(scene.engine.scheduler.failures):toEqual({})
			expect(scene.mount.shutdown()):toBe(true)
			client.dispose()
			scene.dispose()
		end)
		it("refuses failed reads without creating accounts or overwriting earned state", function()
			local scene = Scene.new()
			local first = scene.connect(11)
			first.request({ kind = "accept" })
			expect(scene.mount.world.hit(11, 30)):toBe(true)
			first.request({ kind = "loot", defeatId = assert(scene.mount.world.view(11)).loot[1] })
			first.request({ kind = "claim" })
			local saved = assert(State.copy(scene.values["world:Harbor"]))
			local view = assert(scene.mount.world.view(11))
			local updates = scene.updates()
			scene.control.failRead = true
			first.request({ kind = "craft" })
			expect(assert(first.latest()).ok):toBe(false)
			expect(assert(first.latest()).reason):toBe("retry_exhausted")
			expect(scene.mount.world.view(11)):toEqual(view)
			local second, player = scene.connect(22)
			expect(scene.mount.admission.isAdmitted(player)):toBe(false)
			expect(scene.mount.world.view(22)):toBe(nil)
			expect(scene.updates()):toBe(updates)
			expect(State.copy(scene.values["world:Harbor"])):toEqual(saved)
			expect(scene.mount.world.close(11)):toBe(false)
			expect(scene.mount.world.view(11)):toBe(nil)
			expect(scene.updates()):toBe(updates)
			expect(State.copy(scene.values["world:Harbor"])):toEqual(saved)
			scene.control.failRead = false
			scene.clock.advance(2)
			expect(scene.updates()):toBe(updates + 1)
			expect(scene.mount.world.close(11)):toBe(true)
			expect(scene.disconnect(22)):toBe(true)
			local restored, admitted = scene.connect(22)
			expect(scene.mount.admission.isAdmitted(admitted)):toBe(true)
			expect(scene.mount.world.view(11)):toBe(nil)
			expect(assert(State.copy(scene.values["world:Harbor"])).players["11"].xp):toBe(saved.players["11"].xp)
			expect(scene.engine.scheduler.failures):toEqual({})
			expect(scene.mount.shutdown()):toBe(true)
			first.dispose()
			second.dispose()
			restored.dispose()
			scene.dispose()
		end)
		it("fences pending contact when the native source dies or changes bodies", function()
			for _, replace in { false, true } do
				local scene = Scene.new()
				local client = scene.connect(11)
				local equip: Protocol.EquipRequest = { kind = "equip", itemId = "training_sword" }
				client.request(equip)
				local body = scene.bodies[11]
				local function replacement()
					local nextBody =
						scene.engine.createInstance("Model", { Name = "Replacement", Parent = body.Parent })
					scene.engine.createInstance(
						"Part",
						{ Name = "Root", Parent = nextBody, Anchored = true, Position = Roblox.datatypes.Vector3.zero }
					)
					scene.engine.createInstance("Humanoid", { Parent = nextBody })
					scene.engine.poke(scene.instances[11], "Character", nextBody)
				end
				client.request({ kind = "attack" })
				if replace then
					replacement()
				else
					assert(body:FindFirstChild("Humanoid")).Health = 0
				end
				scene.clock.advance(0.25)
				local health, target = scene.mount.world.enemy()
				expect(health):toBe(30)
				expect(target):toBe("")
				expect(assert(scene.mount.world.view(11)).xp):toBe(0)
				scene.clock.advance(0.3)
				if not replace then
					replacement()
				end
				client.request({ kind = "attack" })
				scene.clock.advance(0.25)
				expect((scene.mount.world.enemy())):toBe(20)
				expect(scene.mount.shutdown()):toBe(true)
				client.dispose()
				scene.dispose()
			end
		end)
		it("rechecks the target generation after a yielding contact observation", function()
			local scene = Scene.new()
			local first = scene.connect(11)
			local second = scene.connect(22)
			local equip: Protocol.EquipRequest = { kind = "equip", itemId = "training_sword" }
			first.request(equip)
			second.request(equip)
			expect(scene.mount.world.hit(22, 20)):toBe(true)
			first.request({ kind = "attack" })
			local held: thread? = nil
			scene.control.onObserve = function(userId: number): ()
				if userId == 11 then
					scene.engine.scheduler.block(function(pending)
						held = pending
					end)
				end
			end
			scene.clock.advance(0.25)
			expect(held == nil):toBe(false)
			second.request({ kind = "attack" })
			scene.clock.advance(0.25)
			expect((scene.mount.world.enemy())):toBe(0)
			scene.clock.advance(3)
			expect((scene.mount.world.enemy())):toBe(30)
			scene.control.onObserve = nil
			scene.engine.scheduler.resume(assert(held))
			scene.clock.advance(0)
			local health, target = scene.mount.world.enemy()
			expect(health):toBe(30)
			expect(target):toBe("")
			expect(assert(scene.mount.world.view(11)).xp):toBe(0)
			expect(assert(scene.mount.world.view(22)).xp):toBe(100)
			expect(scene.mount.shutdown()):toBe(true)
			first.dispose()
			second.dispose()
			scene.dispose()
		end)
		it("discards an old intention when its session changes during admission observation", function()
			local scene = Scene.new()
			local first = scene.connect(11)
			local equip: Protocol.EquipRequest = { kind = "equip", itemId = "training_sword" }
			first.request(equip)
			local held: thread? = nil
			scene.control.onObserve = function(_userId: number): ()
				scene.engine.scheduler.block(function(pending)
					held = pending
				end)
			end
			scene.engine.scheduler.spawn(function()
				first.request({ kind = "attack" })
			end)
			expect(held == nil):toBe(false)
			expect(scene.disconnect(11)):toBe(true)
			first.dispose()
			local second = scene.connect(11)
			scene.control.onObserve = nil
			scene.engine.scheduler.resume(assert(held))
			scene.clock.advance(0.25)
			expect(assert(second.latest()).reason):toBe("attack_unavailable")
			expect((scene.mount.world.enemy())):toBe(30)
			expect(assert(scene.mount.world.view(11)).xp):toBe(0)
