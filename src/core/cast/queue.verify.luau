--!strict

local Queue = require("./queue")
local Scene = require("../../test-scene/cast")
local Verify = require("../../../.lute/dependencies/verify/src/core")

local config: Queue.Config = { windowSec = 0.4, minRetrySec = 0.05, maxRequeues = 4 }

return function(suite: Verify.Harness)
	suite:case("queue admission preserves reason, inclusive window and finite boundaries", function(t)
		local law = Queue.rules(config)
		t:expect(law.shouldQueue("on_gcd", 0.4)):toBe(true)
		for _, remaining in { 0, -1, 0.41, math.huge, -math.huge, (math.huge - math.huge) } do
			t:expect(law.shouldQueue("on_gcd", remaining)):toBe(false)
		end
		t:expect(law.shouldQueue("on_gcd", nil)):toBe(false)
		t:expect(law.shouldQueue(nil, 0.2)):toBe(false)
		t:expect(law.shouldQueue("on_cooldown", 0.2)):toBe(false)
		t:expect(law.delayFor(1e-17)):toBe(0.05)
		t:expect(law.delayFor(0.3)):toBe(0.3)
		t:expect(law.minimumCadenceSec(1.5)):toBe(1.1)
		t:expect(law.minimumCadenceSec(0.2)):toBe(0)
	end)
	suite:case("replacement fences stale callbacks and consumption is once only", function(t)
		local scene = Scene.new(config)
		local first = assert(scene.enqueue("first", 0, "on_gcd", 0.125))
		local original = scene.snapshot()
		local second = assert(scene.enqueue("second", 0, "on_gcd", 0.25))
		t:expect(second.token > first.token):toBe(true)
		scene.clock.advance(0.125)
		t:expect(#scene.fired):toBe(0)
		t:expect(assert(scene.snapshot().queued).payload):toBe("second")
		scene.clock.advance(0.125)
		t:expect(#scene.fired):toBe(1)
		t:expect(scene.fired[1].payload):toBe("second")
		t:expect(scene.fired[1].requeues):toBe(1)
		t:expect(scene.snapshot().queued):toBeNil()
		t:expect(assert(original.queued).payload):toBe("first")
		local unchanged, missing = Queue.take(scene.snapshot(), second.token, scene.clock.clock())
		t:expect(unchanged == scene.snapshot()):toBe(true)
		t:expect(missing):toBeNil()
	end)
	suite:case("cancellation retains token generations and isolates owners", function(t)
		local scene = Scene.new(config)
		local other = Scene.new(config)
		local first = assert(scene.enqueue("cancelled", 0, "on_gcd", 0.25))
		other.enqueue("other", 0, "on_gcd", 0.25)
		scene.cancel(first.token + 1)
		t:expect(scene.snapshot().queued):toEqual(first)
		scene.cancel(nil)
		local replacement = assert(scene.enqueue("replacement", 0, "on_gcd", 0.25))
		scene.cancel(first.token)
		t:expect(replacement.token > first.token):toBe(true)
		scene.clock.advance(1)
		other.clock.advance(1)
		t:expect(#scene.fired):toBe(1)
		t:expect(scene.fired[1].payload):toBe("replacement")
		t:expect(other.fired[1].payload):toBe("other")
		scene.enqueue("stopped", 0, "on_gcd", 0.25)
		scene.cancel(nil)
		scene.clock.advance(1)
		t:expect(#scene.fired):toBe(1)
	end)
	suite:case("retry chains terminate at the bound and refusals preserve state identity", function(t)
		local scene = Scene.new(config)
		for attempt = 0, 3 do
			t:expect(assert(scene.enqueue("cast", attempt, "on_gcd", 1e-17)).requeues):toBe(attempt + 1)
			scene.clock.advance(0.05)
		end
		t:expect(#scene.fired):toBe(4)
		local original = scene.snapshot()
		for _, count in { 4, 5, -1, 0.5, math.huge, (math.huge - math.huge) } do
			t:expect(scene.enqueue("cast", count, "on_gcd", 0.2)):toBeNil()
			t:expect(scene.snapshot() == original):toBe(true)
		end
		t:expect(scene.enqueue("cast", 0, "out_of_range", 0.2)):toBeNil()
		t:expect(scene.snapshot() == original):toBe(true)
	end)
	suite:case("early wakeups preserve the queue until the due clock", function(t)
		local empty: Queue.State<string> = { nextToken = 1 }
		local state, entry = Queue.rules(config).enqueue(empty, "cast", 0, "on_gcd", 0.25, 10)
		local early, missing = Queue.take(state, assert(entry).token, 10.125)
		t:expect(early == state):toBe(true)
		t:expect(missing):toBeNil()
		local taken, result = Queue.take(state, assert(entry).token, 10.25)
		t:expect(result):toEqual(entry)
		t:expect(taken.queued):toBeNil()
		t:expect(empty.nextToken):toBe(1)
		t:expect(empty.queued):toBeNil()
		t:expect(Queue.empty()):toEqual({ nextToken = 1 })
	end)
	suite:case("global cooldown, cast and channel windows expire independently over the clock seam", function(t)
		local scene = Scene.new(config)
		scene.clock.advance(10)
		local windows = Queue.windows(scene.clock.clock(), 1, 2, 3)
		t:expect(Queue.ready(windows, scene.clock.clock())):toBe(false)
		scene.clock.advance(1)
		local gcd, cast, channel = Queue.remaining(windows, scene.clock.clock())
		t:expect({ gcd, cast, channel }):toEqual({ 0, 1, 2 })
		scene.clock.advance(1)
		t:expect(Queue.ready(windows, scene.clock.clock())):toBe(false)
		scene.clock.advance(1)
		t:expect(Queue.ready(windows, scene.clock.clock())):toBe(true)
		t:expect(Queue.ready(windows, 20)):toBe(true)
		t:expect(windows):toEqual({ gcdReadyAt = 11, castReadyAt = 12, channelReadyAt = 13 })
		t:expect(Queue.ready(Queue.windows(10, 0, 0, 0), 10)):toBe(true)
	end)
	suite:case("configuration is captured and invalid timing fails before producing state", function(t)
		local supplied = table.clone(config)
		local law = Queue.rules(supplied)
		supplied.windowSec = 10
		t:expect(law.shouldQueue("on_gcd", 1)):toBe(false)
		for _, invalid in
			{
				{ windowSec = -1, minRetrySec = 0.05, maxRequeues = 4 },
				{ windowSec = 0.4, minRetrySec = 0, maxRequeues = 4 },
				{ windowSec = 0.4, minRetrySec = 0.05, maxRequeues = 0.5 },
				{ windowSec = math.huge, minRetrySec = 0.05, maxRequeues = 4 },
			}
		do
			t:expect((pcall(Queue.rules, invalid))):toBe(false)
		end
		t:expect((pcall(Queue.windows, (math.huge - math.huge), 0, 0, 0))):toBe(false)
		t:expect((pcall(Queue.windows, 0, -1, 0, 0))):toBe(false)
		t:expect((pcall(law.delayFor, math.huge))):toBe(false)
	end)
end
