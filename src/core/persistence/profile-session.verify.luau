--!strict
local Bdd = require("../../../.lute/dependencies/verify/src/bdd")
local Session = require("./profile-session")
local Verify = require("../../../.lute/dependencies/verify/src/core")
local session = Session.create({
	leaseSeconds = 70,
	renewBeforeSeconds = 10,
	coalesceSeconds = 5,
	shutdownSeconds = 8,
	ordinaryReason = "tick",
	immediateReasons = { commit = true },
})
return function(suite: Verify.Harness)
	local test = Bdd.create(suite)
	local describe, it, expect = test.describe, test.it, test.expect
	describe("Profile session lifetime", function()
		it("uses the persisted deadline and rejects nonfinite or expired acquisition times", function()
			local opened = assert(session.openAcquired(10, 49.5))
			expect(opened.leaseExpiresAt):toBe(49.5)
			expect(opened.dirty):toBe(false)
			for _, pair in { { math.huge, 70 }, { 0, 0 / 0 }, { 10, 10 }, { 11, 10 } } do
				local state, reason = session.openAcquired(pair[1], pair[2])
				expect(state):toBe(nil)
				expect(reason):toBe(
					if pair[1] == math.huge or pair[2] ~= pair[2] then "time_invalid" else "lease_expired"
				)
			end
		end)
		it("refuses unlisted dirty reasons without changing pending work", function()
			local state = session.open(0)
			expect(session.dirty(state, 1, "unlisted").reason):toBe("reason_invalid")
			expect(state.dirty):toBe(false)
			expect(state.dirtyDueAt):toBe(nil)
			expect(state.generation):toBe(0)
		end)
		it("retries failed renewal without inventing dirty payload work", function()
			local state = session.open(0)
			expect(session.begin(state, 60).kind):toBe("renewal")
			expect(session.finish(state, 61, false).ok):toBe(false)
			expect(state.failed):toBe(true)
			expect(state.dirty):toBe(false)
			expect(state.leaseLost):toBe(false)
			expect(session.due(state, 61)):toBe(true)
			expect(session.begin(state, 61).kind):toBe("renewal")
		end)
		it("fences dirty begin and close at expiry without changing generations", function()
			for _, now in { 70, 71 } do
				for _, operation in { "dirty", "begin", "close" } do
					local state = session.open(0)
					expect(session.due(state, now)):toBe(false)
					local result = if operation == "dirty"
						then session.dirty(state, now, "commit")
						else if operation == "begin" then session.begin(state, now) else session.close(state, now)
					expect(result.reason):toBe("lease_lost")
					expect(state.leaseLost):toBe(true)
					expect(state.dirty):toBe(false)
					expect(state.generation):toBe(0)
					expect(state.inFlightGeneration):toBe(nil)
					expect(state.closed):toBe(false)
				end
			end
		end)
		it("fences an idle renewal completing exactly at expiry", function()
			local state = session.open(0)
			assert(session.begin(state, 60).ok)
			expect(session.finish(state, 70, true).reason):toBe("lease_lost")
			expect(state.leaseExpiresAt):toBe(70)
			expect(state.inFlightGeneration):toBe(nil)
			expect(state.dirty):toBe(false)
			expect(session.due(state, 70)):toBe(false)
		end)
		it("preserves a close arriving during a save and drains its own generation", function()
			local state = session.open(0)
			assert(session.dirty(state, 0, "commit").ok)
			local flight = session.begin(state, 0)
			assert(session.close(state, 1).ok)
			expect(state.generation):toBe(assert(flight.generation) + 1)
			assert(session.finish(state, 2, true).ok)
			expect(state.dirty):toBe(true)
			expect(state.released):toBe(false)
			expect(session.begin(state, 2).kind):toBe("close")
			assert(session.finish(state, 3, true).ok)
			expect(state.released):toBe(true)
			expect(state.leaseExpiresAt):toBe(3)
			expect(state.dirty):toBe(false)
		end)
		it("keeps repeated close fixed and refuses it after expiry or without a flight", function()
			local state = session.open(0)
			expect(session.finish(state, 1, true).reason):toBe("no_flight")
			assert(session.close(state, 2).ok)
			local generation, deadline = state.generation, state.shutdownDueAt
			assert(session.close(state, 3).ok)
			expect(state.generation):toBe(generation)
			expect(state.shutdownDueAt):toBe(deadline)
			expect(session.begin(state, 3).kind):toBe("close")
			local expired = session.open(0)
			assert(session.close(expired, 69).ok)
			local prior = expired.generation
			expect(session.close(expired, 70).reason):toBe("lease_lost")
			expect(expired.generation):toBe(prior)
		end)
		it("preserves changes arriving during a successful save", function()
			local state = assert(session.openAcquired(0, 70))
			expect(session.dirty(state, 1, "tick").ok):toBe(true)
			expect(session.due(state, 5)):toBe(false)
			expect(session.begin(state, 6).kind):toBe("save")
			expect(session.dirty(state, 7, "commit").ok):toBe(true)
			expect(session.finish(state, 8, true).ok):toBe(true)
			expect(state.dirty):toBe(true)
			expect(session.begin(state, 8).kind):toBe("save")
			expect(session.finish(state, 9, true).ok):toBe(true)
			expect(state.dirty):toBe(false)
		end)
		it("renews an idle session but refuses a save that completes after lease expiry", function()
			local state = assert(session.openAcquired(0, 70))
			expect(session.begin(state, 60).kind):toBe("renewal")
			expect(session.finish(state, 61, true).ok):toBe(true)
			expect(state.leaseExpiresAt):toBe(131)
			session.dirty(state, 62, "commit")
			session.begin(state, 62)
			expect(session.finish(state, 131, true).reason):toBe("lease_lost")
			expect(session.dirty(state, 132, "commit").ok):toBe(false)
			expect(state.released):toBe(false)
		end)
		it("drains close within its budget and keeps an expired close dirty and unreleased", function()
			local state = session.open(0)
			expect(session.dirty(state, 0, "unlisted").reason):toBe("reason_invalid")
			expect(session.close(state, 1).ok):toBe(true)
			expect(session.begin(state, 1).kind):toBe("close")
			expect(session.finish(state, 10, true).reason):toBe("shutdown_expired")
			expect(state.dirty):toBe(true)
			expect(state.released):toBe(false)
			local healthy = session.open(0)
			session.close(healthy, 1)
			session.begin(healthy, 1)
			expect(session.finish(healthy, 9, true).ok):toBe(true)
			expect(healthy.released):toBe(true)
		end)
	end)
end
